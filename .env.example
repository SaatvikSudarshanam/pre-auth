# Copy this file to backend/.env and fill in real values.
#   cp .env.example backend/.env
# NEVER commit backend/.env.

APP_NAME=PreAuthIQ
BACKEND_PORT=8068
# Where the browser reaches the frontend (used for OAuth redirects).
FRONTEND_URL=http://localhost:5173
# In Docker, set FRONTEND_URL=http://localhost:8080

# --- LLM (admin-side only) ---
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Google OAuth (customer sign-in) ---
# The redirect URI must be registered in the Google Cloud console exactly.
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8068/rbac/oauth/google/callback

# --- Admin auth (DEMO ONLY — replace before production) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@2026

# --- JWT signing ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# --- Policy versions (bump to force re-consent) ---
PRIVACY_POLICY_VERSION=2026-07-12
COOKIE_POLICY_VERSION=2026-07-12
