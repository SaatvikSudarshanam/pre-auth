# Copy this file to backend/.env and fill in real values.
#   cp .env.example backend/.env
# NEVER commit backend/.env.

APP_NAME=PreAuthIQ
BACKEND_PORT=8068
# Where the browser reaches the frontend (used for OAuth redirects).
FRONTEND_URL=http://localhost:5173
# In Docker, set FRONTEND_URL=http://localhost:8080

# --- LLM (admin-side only) ---
LLM_PROVIDER=groq
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Google OAuth (customer sign-in) ---
# The redirect URI must be registered in the Google Cloud console exactly.
GOOGLE_CLIENT_ID=863556078606-aj9viqbbve58r51bo2jdoh6jqutabglr.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REDIRECT_URI=http://localhost:8068/rbac/oauth/google/callback

# --- Admin auth (DEMO ONLY — replace before production) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@2026

# --- JWT signing ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# --- Twilio voice (admin decision phone calls) ---
# Get these from https://console.twilio.com/
# TWILIO_ACCOUNT_SID: your Twilio Account SID (e.g. ACfc22635530700e9b1fdef852f3f37886)
# TWILIO_AUTH_TOKEN: your Twilio Auth Token
# TWILIO_PHONE_NUMBER: your voice-enabled Twilio phone number (e.g. +17372212163)
#   This is the "from" number for outbound calls.
# TWILIO_TEST_PHONE_NUMBER: Static test phone number used when customer has no phone on file.
#   Useful for testing without customer profile updates. (default: +919014582844)
# TWILIO_CALLBACK_URL: For trial accounts only — the base URL where Twilio can fetch TwiML.
#   Example: https://abc123.ngrok.io/api/twilio/twiml
#   See README for ngrok setup instructions. Leave empty for paid accounts (uses inline TwiML).
# Each customer's "to" number is collected in their profile as E.164 format (e.g. +919014582844).
# Trial accounts: verify destination phone numbers in Twilio Console first.
TWILIO_ACCOUNT_SID=ACfc22635530700e9b1fdef852f3f37886
TWILIO_AUTH_TOKEN=1638ce0ebdab9e3bb89b924a98c47c29
TWILIO_PHONE_NUMBER=+17372212163
TWILIO_TEST_PHONE_NUMBER=+919014582844
TWILIO_CALLBACK_URL=

# --- n8n automation (optional) ---
# When N8N_WEBHOOK_URL is set, decision calls are POSTed to the n8n workflow
# instead of hitting Twilio directly from this backend. Twilio credentials then
# live in n8n only. Leave empty to keep calling Twilio directly.
# Use the PRODUCTION url (/webhook/...), not the test url (/webhook-test/...);
# the test url only fires while the n8n canvas has "Listen for test event" open.
#   N8N_WEBHOOK_URL=https://<your-n8n-host>/webhook/c76a202b-a40b-4d23-85c6-e015bdd8e713
# N8N_WEBHOOK_TOKEN: optional shared secret; sent as "Authorization: Bearer <token>".
#   Match it with Header Auth credentials on the n8n Webhook node.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
N8N_TIMEOUT_SECONDS=15

# --- Policy versions (bump to force re-consent) ---
PRIVACY_POLICY_VERSION=2026-07-12
COOKIE_POLICY_VERSION=2026-07-12
